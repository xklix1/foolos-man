rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // هام: قم بتحديث UID بالمعرّف الصحيح لحساب adminkhalid911@foolos-man.com
    // من Firebase Console → Authentication → Users بعد ما تنشئ الحساب.
    function isAdmin() {
      return request.auth != null && 
             (request.auth.uid == "PLACEHOLDER_UPDATE_WITH_NEW_UID" ||
              request.auth.token.email == "adminkhalid911@foolos-man.com");
    }

    // ─────────────────────────────────────────────
    // 1. حسابات وبيانات اللاعبين (Players Collection)
    // ─────────────────────────────────────────────
    match /players/{username} {
      // القراءة متاحة لتوب الأغنياء والتحقق من تسجيل الدخول
      allow read: if true;

      // إنشاء حساب جديد:
      // - الأدمن بدون قيود
      // - اللاعب العادي: لا يمكنه جعل نفسه أدمن، والثروة الأولية لا تتجاوز 10,000 ج.م
      allow create: if isAdmin() || (
        request.resource.data.username == username &&
        request.resource.data.isAdmin == false &&
        request.resource.data.netWorth <= 10000 &&
        request.resource.data.cash <= 10000 &&
        request.resource.data.keys().hasAll(['username', 'pin', 'netWorth', 'cash', 'bank'])
      );

      // تعديل الحساب (حماية قصوى ضد الغش وسرقة الحسابات):
      // - الأدمن بدون قيود
      // - اللاعب العادي:
      //   1. لا يمكنه تحويل نفسه لأدمن (isAdmin تبقى false).
      //   2. لا يمكنه تغيير الـ PIN في عمليات الحفظ العادية إلا إذا كان مطابقاً للـ PIN الأصلي.
      //   3. لا يمكنه تغيير اسم المستخدم (username ثابت ومطابق لاسم المستند).
      allow update: if isAdmin() || (
        request.resource.data.isAdmin == false &&
        resource.data.isAdmin == false &&
        request.resource.data.username == resource.data.username &&
        request.resource.data.pin == resource.data.pin
      );

      // حذف الحساب: محصور بالأدمن فقط
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 2. سجلات التحويلات المالية (Wire Transfers)
    // ─────────────────────────────────────────────
    match /transfers/{id} {
      allow read: if true;
      allow create: if request.resource.data.amount > 0 &&
                       request.resource.data.sender != request.resource.data.recipient &&
                       request.resource.data.keys().hasAll(['sender', 'recipient', 'amount', 'timestamp']);
      allow update, delete: if false; // السجلات غير قابلة للتعديل أو التلاعب
    }

    // ─────────────────────────────────────────────
    // 3. إعدادات اللعبة، البورصة، والأخبار (Globals)
    // ─────────────────────────────────────────────
    match /globals/{id} {
      allow read: if true;
      allow write: if isAdmin(); // الأدمن الموثق فقط من يملك صلاحية تعديل الإعدادات والبورصة
    }

    // ─────────────────────────────────────────────
    // 4. طلبات التحويل المالية (Transfer Requests)
    // ─────────────────────────────────────────────
    match /transferRequests/{id} {
      allow read: if true;
      allow create: if request.resource.data.amount > 0 &&
                       request.resource.data.sender != request.resource.data.recipient &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.keys().hasAll(['sender', 'recipient', 'amount', 'timestamp', 'status']);
      allow update: if request.resource.data.status in ['accepted', 'rejected'] &&
                       resource.data.status == 'pending';
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 5. مزادات الأدوات والصفقات (Auctions)
    // ─────────────────────────────────────────────
    match /auctions/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 6. أكواد الهدايا والمكافآت (Gift Codes)
    // ─────────────────────────────────────────────
    match /giftCodes/{code} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 7. النسخ الاحتياطية للاعبين (Player Backups)
    // ─────────────────────────────────────────────
    match /players/{username}/backups/{dateString} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.cash == get(/databases/$(database)/documents/players/$(username)).data.cash &&
        request.resource.data.bank == get(/databases/$(database)/documents/players/$(username)).data.bank &&
        request.resource.data.netWorth == get(/databases/$(database)/documents/players/$(username)).data.netWorth &&
        request.resource.data.pin == get(/databases/$(database)/documents/players/$(username)).data.pin
      );
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 8. الدردشة العامة (Public Chat)
    // ─────────────────────────────────────────────
    match /chat/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 9. صندوق البريد والتنبيهات (Mailbox & Letters)
    // ─────────────────────────────────────────────
    match /mailbox/{mailId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────
    // 10. الشركات المشتركة (Corporations)
    // ─────────────────────────────────────────────
    match /corporations/{corpId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────
    // 11. المزادات الحية (Live Auctions)
    // ─────────────────────────────────────────────
    match /liveAuctions/{auctionId} {
      allow read, write: if true;
      allow delete: if isAdmin();
    }
  }
}
