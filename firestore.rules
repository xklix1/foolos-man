rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // 1. حسابات وبيانات اللاعبين (Players Collection)
    // ─────────────────────────────────────────────
    match /players/{username} {
      allow read: if true;

      // إنشاء حساب جديد: يمنع الثروات المزيفة ويمنع منح رتبة أدمن
      allow create: if request.resource.data.username == username &&
                       request.resource.data.isAdmin == false &&
                       request.resource.data.netWorth <= 10000 &&
                       request.resource.data.cash <= 10000;

      // تعديل بيانات الحساب: يمنع تغيير اسم المستخدم أو جعل الحساب أدمن
      allow update: if request.resource.data.username == resource.data.username &&
                       request.resource.data.isAdmin == false;

      // السماح بالحذف للوحة التحكم الإدارية
      allow delete: if true;
    }

    // ─────────────────────────────────────────────
    // 2. سجلات التحويلات المالية (Transfers)
    // ─────────────────────────────────────────────
    match /transfers/{id} {
      allow read: if true;
      allow create: if request.resource.data.amount > 0 &&
                       request.resource.data.sender != request.resource.data.recipient;
      allow update, delete: if true;
    }

    // ─────────────────────────────────────────────
    // 3. الإعدادات، البورصة، والليدربورد (Globals)
    // ─────────────────────────────────────────────
    match /globals/{id} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────
    // 4. طلبات التحويل المالية (Transfer Requests)
    // ─────────────────────────────────────────────
    match /transferRequests/{id} {
      allow read, create, update, delete: if true;
    }

    // ─────────────────────────────────────────────
    // 5. المزادات الحية والأكواد والرسائل والشركات
    // ─────────────────────────────────────────────
    match /auctions/{id} {
      allow read, write: if true;
    }

    match /giftCodes/{code} {
      allow read, write: if true;
    }

    match /mailbox/{mailId} {
      allow read, write: if true;
    }

    match /corporations/{corpId} {
      allow read, write: if true;
    }

    match /liveAuctions/{auctionId} {
      allow read, write: if true;
    }

    match /chat/{messageId} {
      allow read, write: if true;
    }
  }
}
